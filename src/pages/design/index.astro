---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Design Inspiration">
    <div class="py-16 md:py-24 text-center bg-secondary text-white mb-12">
        <h1 class="text-5xl md:text-6xl font-heading font-bold mb-6 animate-slide-up">Design Inspiration</h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto font-light animate-slide-up delay-100">
            Explore curated interiors featuring our bespoke solid wood furniture pieces.
        </p>
    </div>

    <div class="container mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-8">
            <div class="bg-gray-100 rounded-xl overflow-hidden shadow-sm h-96 flex items-center justify-center text-gray-400">
                <span class="uppercase tracking-widest font-bold text-sm">Gallery Coming Soon</span>
            </div>
             <div class="bg-gray-100 rounded-xl overflow-hidden shadow-sm h-96 flex items-center justify-center text-gray-400">
                <span class="uppercase tracking-widest font-bold text-sm">Gallery Coming Soon</span>
            </div>
             <div class="bg-gray-100 rounded-xl overflow-hidden shadow-sm h-96 flex items-center justify-center text-gray-400">
                <span class="uppercase tracking-widest font-bold text-sm">Gallery Coming Soon</span>
            </div>
             <div class="bg-gray-100 rounded-xl overflow-hidden shadow-sm h-96 flex items-center justify-center text-gray-400">
                <span class="uppercase tracking-widest font-bold text-sm">Gallery Coming Soon</span>
            </div>
        </div>
    </div>
</BaseLayout>
