---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home">
	<div class="text-center py-16 max-w-4xl mx-auto">
		<h1 class="text-5xl font-bold mb-6 text-secondary">Expert Guides for Solid Wood Furniture</h1>
		<p class="text-xl text-gray-600 mb-10 leading-relaxed">
			Discover everything you need to know about choosing, caring for, and styling 
            handcrafted live edge and solid wood furniture.
		</p>
        <div class="flex justify-center gap-4">
             <a href="/guides" class="bg-primary text-white px-8 py-3 font-medium hover:bg-opacity-90 transition-opacity">Explore Guides</a>
             <a href="/materials" class="border border-secondary px-8 py-3 font-medium hover:bg-secondary hover:text-white transition-colors">Material Library</a>
        </div>
	</div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 py-12">
        <!-- Feature cards would go here - static for now -->
        <div class="p-8 border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
            <h3 class="text-2xl font-bold mb-3 text-primary">Buying Guides</h3>
            <p class="text-gray-600 mb-4">Size guides, wood comparisons, and how to choose the perfect table for your space.</p>
            <a href="/guides" class="font-medium hover:text-primary underline decoration-2 underline-offset-4">Read Guides &rarr;</a>
        </div>
        <div class="p-8 border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
             <h3 class="text-2xl font-bold mb-3 text-primary">Wood Care</h3>
             <p class="text-gray-600 mb-4">Learn how to protect your investment from humidity, spills, and daily wear.</p>
             <a href="/care" class="font-medium hover:text-primary underline decoration-2 underline-offset-4">Read Care Tips &rarr;</a>
        </div>
         <div class="p-8 border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
             <h3 class="text-2xl font-bold mb-3 text-primary">Design Ideas</h3>
             <p class="text-gray-600 mb-4">Inspiration for modern organic, industrial, and contemporary interiors.</p>
             <a href="/design" class="font-medium hover:text-primary underline decoration-2 underline-offset-4">View Inspiration &rarr;</a>
        </div>
    </div>
</BaseLayout>
