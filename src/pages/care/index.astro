---
import BaseLayout from '../../layouts/BaseLayout.astro';
const posts = await Astro.glob('./*.mdx');
---

<BaseLayout title="Care & Maintenance">
    <div class="py-16 md:py-24 text-center bg-secondary text-white mb-12">
        <h1 class="text-5xl md:text-6xl font-heading font-bold mb-6 animate-slide-up">Care & Maintenance</h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto font-light animate-slide-up delay-100">
            Learn how to protect your investment and keep your solid wood furniture looking beautiful for generations.
        </p>
    </div>

    <div class="container mx-auto px-6 grid md:grid-cols-2 lg:grid-cols-3 gap-10">
        {posts.map((post) => (
            <a href={post.url} class="group block bg-white border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 overflow-hidden rounded-xl">
               <div class="h-48 bg-gray-200 overflow-hidden relative">
                     <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                     <span class="absolute bottom-4 left-4 text-white text-xs font-bold uppercase tracking-widest bg-primary px-2 py-1 rounded">Read Article</span>
                </div>
                <div class="p-8">
                    <h2 class="text-2xl font-heading font-bold mb-3 text-secondary group-hover:text-primary transition-colors">
                        {post.frontmatter.title}
                    </h2>
                    <p class="text-gray-600 line-clamp-3 leading-relaxed mb-4">
                        {post.frontmatter.description}
                    </p>
                    <span class="text-primary font-bold text-sm uppercase tracking-wider flex items-center">
                        Read More <svg class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                    </span>
                </div>
            </a>
        ))}
    </div>
</BaseLayout>
