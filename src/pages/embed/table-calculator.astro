---
import "../../styles/global.css";
import TableCalculator from "../../components/TableCalculator.astro";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/playfair-display/400.css";
import "@fontsource/playfair-display/600.css";
import "@fontsource/playfair-display/700.css";
---

<!doctype html>
<html lang="en" class="bg-transparent">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Urbis Table Calculator Embed</title>
        <!-- Google tag (gtag.js) -->
        <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-080DVEFY0Y"
        ></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                dataLayer.push(arguments);
            }
            gtag("js", new Date());

            gtag("config", "G-080DVEFY0Y");
        </script>
    </head>
    <body
        class="min-h-screen flex items-center justify-center p-4 bg-transparent"
    >
        <div class="w-full max-w-4xl">
            <TableCalculator />
        </div>
    </body>
</html>
