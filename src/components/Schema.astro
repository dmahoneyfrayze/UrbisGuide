---
import type { CollectionEntry } from "astro:content";

interface Props {
  type?: "Article" | "HowTo" | "CollectionPage";
  title: string;
  description: string;
  url: string;
  image?: string;
  publishDate?: string;
  faqs?: { question: string; answer: string }[];
  parent?: { name: string; url: string };
  items?: { name: string; url: string; description?: string }[];
}

const {
  type = "Article",
  title,
  description,
  url,
  image,
  publishDate,
  faqs,
  parent,
  items,
} = Astro.props;

const siteUrl = "https://guide.urbisconcepts.com";
const logoUrl =
  "https://urbisconcepts.com/cdn/shop/files/Urbis_Concepts_Logo_Black.png?v=1680000000";

const baseSchema = {
  "@context": "https://schema.org",
  "@graph": [] as any[],
};

// ... Organization and WebSite schemas remain the same ...
// 1. Organization Schema (Global)
const organizationSchema = {
  "@type": "Organization",
  "@id": `${siteUrl}/#organization`,
  name: "Urbis Concepts",
  url: siteUrl,
  logo: {
    "@type": "ImageObject",
    url: logoUrl,
  },
  sameAs: [
    "https://urbisconcepts.com",
    "https://www.instagram.com/urbisconcepts/",
    "https://www.facebook.com/urbisconcepts/",
  ],
};
baseSchema["@graph"].push(organizationSchema);

// 1.5 Local Business Schema (Furniture Store)
const storeSchema = {
  "@type": "FurnitureStore",
  "@id": `${siteUrl}/#store`,
  name: "Urbis Concepts",
  image: logoUrl,
  url: siteUrl,
  telephone: "+16478665799",
  priceRange: "$$$",
  address: {
    "@type": "PostalAddress",
    streetAddress: "122 Evans Ave",
    addressLocality: "Etobicoke",
    addressRegion: "ON",
    postalCode: "M8Z 5W2",
    addressCountry: "CA",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 43.6166,
    longitude: -79.5118,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
      ],
      opens: "10:00",
      closes: "18:00",
    },
  ],
  areaServed: [
    "Toronto",
    "Etobicoke",
    "Mississauga",
    "Oakville",
    "Burlington",
    "Greater Toronto Area",
  ],
};
baseSchema["@graph"].push(storeSchema);

// 2. WebSite Schema (Global)
const websiteSchema = {
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  url: siteUrl,
  name: "Urbis Concepts Guide",
  description: "Expert guides on solid wood furniture, care, and design.",
  publisher: { "@id": `${siteUrl}/#organization` },
};
baseSchema["@graph"].push(websiteSchema);

// 3. Primary Page Entity
let mainEntity: any = {
  "@type": type,
  "@id": `${url}#${type.toLowerCase()}`,
  isPartOf: { "@id": `${url}` },
  headline: title,
  description: description,
  image:
    image ||
    "https://urbisconcepts.com/cdn/shop/files/Live_Edge_Parota_Table.png?v=1764875346",
  datePublished: publishDate || new Date().toISOString(),
  author: { "@id": `${siteUrl}/#organization` },
  publisher: { "@id": `${siteUrl}/#organization` },
};

if (type === "HowTo") {
  mainEntity["@type"] = "Article"; // Fallback for safety, can be enhanced
}

baseSchema["@graph"].push(mainEntity);

// 4. BreadcrumbList
const breadcrumbItems = [
  {
    "@type": "ListItem",
    position: 1,
    name: "Home",
    item: siteUrl,
  },
];

if (parent) {
  breadcrumbItems.push({
    "@type": "ListItem",
    position: 2,
    name: parent.name,
    item: `${siteUrl}${parent.url}`,
  });
}

breadcrumbItems.push({
  "@type": "ListItem",
  position: parent ? 3 : 2,
  name: title,
  item: url,
});

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems,
};
baseSchema["@graph"].push(breadcrumbSchema);

// 5. FAQPage
if (faqs && faqs.length > 0) {
  // ... existing FAQ logic
  const faqSchema = {
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  };
  baseSchema["@graph"].push(faqSchema);
}

// 6. ItemList
if (items && items.length > 0) {
  const itemListSchema = {
    "@type": "ItemList",
    itemListElement: items.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: item.url.startsWith("http") ? item.url : `${siteUrl}${item.url}`,
      name: item.name,
      description: item.description,
    })),
  };
  baseSchema["@graph"].push(itemListSchema);
}
---

<script type="application/ld+json" set:html={JSON.stringify(baseSchema)} />
