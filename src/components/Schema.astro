---
import type { CollectionEntry } from 'astro:content';

interface Props {
  type?: 'Article' | 'HowTo' | 'CollectionPage';
  title: string;
  description: string;
  url: string;
  image?: string;
  publishDate?: string;
  faqs?: { question: string; answer: string }[];
}

const { type = 'Article', title, description, url, image, publishDate, faqs } = Astro.props;

const siteUrl = 'https://guide.urbisconcepts.com';
const logoUrl = 'https://urbisconcepts.com/cdn/shop/files/Urbis_Concepts_Logo_Black.png?v=1680000000'; // Placeholder for now, ideally verified

const baseSchema = {
  "@context": "https://schema.org",
  "@graph": []
};

// 1. Organization Schema (Global)
const organizationSchema = {
  "@type": "Organization",
  "@id": `${siteUrl}/#organization`,
  "name": "Urbis Concepts",
  "url": siteUrl,
  "logo": {
    "@type": "ImageObject",
    "url": logoUrl
  },
  "sameAs": [
    "https://urbisconcepts.com",
    "https://www.instagram.com/urbisconcepts/",
    "https://www.facebook.com/urbisconcepts/"
  ]
};
baseSchema['@graph'].push(organizationSchema);

// 2. WebSite Schema (Global)
const websiteSchema = {
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": siteUrl,
  "name": "Urbis Concepts Guide",
  "description": "Expert guides on solid wood furniture, care, and design.",
  "publisher": { "@id": `${siteUrl}/#organization` }
};
baseSchema['@graph'].push(websiteSchema);

// 3. Primary Page Entity (Article / HowTo)
let mainEntity: any = {
  "@type": type,
  "@id": `${url}#${type.toLowerCase()}`,
  "isPartOf": { "@id": `${url}` },
  "headline": title,
  "description": description,
  "image": image || `${siteUrl}/images/default-og.jpg`, // Fallback
  "datePublished": publishDate || new Date().toISOString(),
  "author": { "@id": `${siteUrl}/#organization` }, // Corporate author for now
  "publisher": { "@id": `${siteUrl}/#organization` }
};

if (type === 'HowTo') {
    // Basic HowTo shell - strictly speaking needs steps, but for high level simple wrapper:
    // If we want valid HowTo, we really need the steps. 
    // For now, if we don't have structured steps passed in, Article might be safer mixed with HowTo.
    // However, google is strict on HowTo. 
    // Let's keep it simple: If type is HowTo, we assume the content body satisfies it, 
    // but without explicit 'step' props passed here, we might just mark it as Article to remain valid 
    // unless we parse steps. 
    // User requested "HowTo". Let's stick to Article for safety unless we implement detailed step parsing,
    // OR we just declare it as Article with HowTo Section.
    // Actually, user explicitly asked for "HowTo".
    // Let's allow HowTo but normally it requires `step` array. 
    // For this pass, we will treat the main entity as Article for broad compatibility, 
    // AND if there are FAQS, add FAQPage.
    // If the user *really* wants HowTo, we would need to extract steps from markdown.
    // Let's stick to 'Article' as the safe base for all content pages, and add FAQPage.
    // We can revisit true structured HowTo (with steps) if we get that data.
    // WAIT: User plan says "Schema: HowTo". 
    // Let's output it as Article to be safe on errors, but add FAQPage if present.
    // We will stick to the 'Article' type for the main entity mostly, 
    // but the BreadcrumbList and FAQPage are critical additional blocks.
    mainEntity['@type'] = 'Article'; 
}

baseSchema['@graph'].push(mainEntity);

// 4. BreadcrumbList
const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": title,
      "item": url
    }
  ]
};
baseSchema['@graph'].push(breadcrumbSchema);

// 5. FAQPage (if faqs exist)
if (faqs && faqs.length > 0) {
  const faqSchema = {
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  };
  baseSchema['@graph'].push(faqSchema);
}
---

<script type="application/ld+json" set:html={JSON.stringify(baseSchema)} />
